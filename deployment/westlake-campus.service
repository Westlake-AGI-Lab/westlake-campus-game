[Unit]
Description=Westlake Campus Multiplayer Game
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/apps/westlake-campus/current
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=ACCOUNT_DB=%h/apps/westlake-campus/shared/accounts.sqlite
ExecStart=/usr/bin/node dist-server/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=yes
MemoryMax=512M

[Install]
WantedBy=default.target
